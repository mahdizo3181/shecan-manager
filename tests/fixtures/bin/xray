#!/usr/bin/env bash
# fake xray: version / run -test / run (really listens on the first inbound's port)
case ${1:-} in
  version) echo "Xray 26.3.27 (Xray, Penetrates Everything.) fake"; exit 0 ;;
esac
cfg=""; test=0
for ((i=1;i<=$#;i++)); do a=${!i}; [[ $a == -test ]] && test=1; [[ $a == -config ]] && { j=$((i+1)); cfg=${!j}; }; done
[[ -f $cfg ]] || { echo "no config" >&2; exit 1; }
if ((test)) && [[ ${XRAY_FAKE_REJECT:-} == 1 ]] && grep -q 'ir-gemini' "$cfg"; then echo "infra/conf: rejected by the fake xray" >&2; exit 1; fi
if ((test)); then python3 -c 'import json,sys;json.load(open(sys.argv[1]))' "$cfg" 2>/dev/null && exit 0; echo "invalid json" >&2; exit 1; fi
exec python3 - "$cfg" <<'PY'
import json, socket, sys, threading
c = json.load(open(sys.argv[1]))
ib = (c.get("inbounds") or [None])[0]
if not c.get("inbounds"):
    import time; time.sleep(1000000)
s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind((ib.get("listen", "127.0.0.1"), int(ib["port"]))); s.listen(16)
while True:
    k, _ = s.accept(); k.close()
PY
